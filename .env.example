# Mode de dades: "local" o "firebase".
# - local: les dades es guarden al navegador (IndexedDB). Ideal per provar-ho tot
#   sense crear cap compte. No serveix per compartir el catàleg entre persones.
# - firebase: Firestore + Authentication reals. Cal un projecte de Firebase.
VITE_DATA_MODE=local

# Només cal omplir-ho si VITE_DATA_MODE=firebase.
# Aquestes claus són públiques per disseny: la seguretat la garanteixen les
# regles de Firestore (fitxer firestore.rules). No hi posis cap secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correu tècnic de Firebase associat a l'usuari "admin".
VITE_ADMIN_EMAIL=admin@edueines.cat

# Per a un lloc de projecte de GitHub Pages: /nom-del-repositori/
# Per a un domini propi o un servidor arrel: /
VITE_BASE_PATH=/
